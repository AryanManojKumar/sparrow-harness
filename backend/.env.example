# Copy to backend/.env. Never commit the real file.

# --- text and vision ------------------------------------------------------
# Which provider backs the Tier abstraction: azure | openai | anthropic.
SPARROW_PROVIDER=azure

# azure — VoiceOwl's API Management gateway in front of Azure OpenAI.
# The subscription key is 32 hex characters, from the APIM instance's
# Subscriptions blade (Show/hide keys → Primary key). A UUID from that same
# blade is the subscription *id* and authenticates as nothing.
# The gateway publishes no /models endpoint; an unknown model name returns 400
# with the current allowlist in the message, which is the only catalogue there
# is. See MODELS["azure"] in src/sparrow/providers.py.
AZURE_APIM_KEY=
AZURE_APIM_BASE_URL=https://voiceowl-ai-apim-gateway.azure-api.net/openai/v1

# openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# anthropic — an API key, which is a different thing from a Claude Code
# subscription: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- imagery --------------------------------------------------------------
# KIE.ai — https://kie.ai/api-key
# Text-to-image and image-to-image are separate models; the defaults below are
# the ones verified on this account. The allowlist is per account and is not
# published, so confirm a new id against createTask before setting it: 422 means
# unsupported, 500 naming a missing field means supported.
KIE_API_KEY=
KIE_IMAGE_MODEL=qwen3/pro-text-to-image
KIE_EDIT_MODEL=google/nano-banana-edit

# --- optional -------------------------------------------------------------
# NVIDIA NIM. Not wired into the harness; kept for benchmarking. Note the public
# gateway queues for minutes before the first byte on some models.
NVIDIA_API_KEY=

SPARROW_LOG_LEVEL=
SPARROW_LOG_PROMPTS=

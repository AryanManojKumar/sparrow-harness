{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/site:*)",
      "Bash(./bin/site:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(curl:*)",
      "Read(//**)",
      "Edit(projects/**)",
      "Write(projects/**)"
    ],
    "deny": [
      "Edit(backend/**)",
      "Write(backend/**)",
      "Edit(frontend/**)",
      "Write(frontend/**)",
      "Edit(scaffold/**)",
      "Write(scaffold/**)",
      "Edit(CLAUDE.md)",
      "Read(backend/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py\""
          }
        ]
      }
    ]
  }
}
